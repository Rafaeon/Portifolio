@model Portifolio.Models.NewsletterPostInput
@{
    ViewData["Title"] = "Novo post";
}

<div class="row">
    <div class="col-lg-9 mx-auto">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Admin</a></li>
                <li class="breadcrumb-item active">Novo post</li>
            </ol>
        </nav>

        <p class="section-kicker">Newsletter</p>
        <h1 class="display-6 fw-bold mb-2">Criar post</h1>
        <p class="text-muted mb-4">Marque como privado se quiser que só o admin veja.</p>

        <div class="card">
            <div class="card-body p-4">
                <form asp-controller="Admin" asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label">Título</label>
                        <input asp-for="Titulo" class="form-control" autofocus />
                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Resumo" class="form-label">Resumo <span class="text-muted">(opcional)</span></label>
                        <input asp-for="Resumo" class="form-control" maxlength="300" />
                        <span asp-validation-for="Resumo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Conteudo" class="form-label">Conteúdo</label>
                        <textarea asp-for="Conteudo" class="form-control" rows="10"></textarea>
                        <span asp-validation-for="Conteudo" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Publico" class="form-check-input" />
                        <label asp-for="Publico" class="form-check-label">Público (visível para todos)</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Salvar</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
