@{
    ViewData["Title"] = "HomeLab";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
                <li class="breadcrumb-item active">HomeLab</li>
            </ol>
        </nav>

        <p class="section-kicker">Infra · produção real</p>
        <h1 class="display-6 fw-bold mb-3">HomeLab</h1>

        <section class="mb-5">
            <h2 class="h4 mb-3">Visão Geral</h2>
            <p>
                Infraestrutura doméstica com dois servidores em operação real — não um ambiente de testes,
                mas um lab que roda uma pilha de serviços self-hosted, hospeda aplicações .NET com pipeline CI/CD,
                tem rede segmentada com firewall dedicado e observabilidade com Prometheus e Grafana.
            </p>
            <p>
                O objetivo é aprender fazendo: cada serviço, cada VM e cada decisão de rede resolve um problema real
                ou simula um cenário que existe em ambientes corporativos.
            </p>
            <div class="alert alert-info">
                <strong>Modelo Híbrido:</strong> A rede do homelab é separada da rede da casa.
                Se algo quebrar no laboratório, a internet da casa continua funcionando normalmente.
            </div>
        </section>

        <section class="mb-5">
            <h2 class="h4 mb-3">Arquitetura de Rede</h2>
            <div class="mermaid">
                graph TB
                subgraph "Internet"
                INET[Internet]
                end

                subgraph "Rede da Casa"
                ROTEADOR[Roteador do Provedor<br />Wi-Fi + NAT + DHCP]
                WIFI[Celular / Wi-Fi da Casa]
                end

                subgraph "Homelab"
                OPN[OPNsense VM<br />Firewall]
                SWITCH[Switch Homelab]
                NPM[Nginx Proxy<br />Manager]
                subgraph "eva-01 (Desktop)"
                DOCKER1[Docker Services<br />Jellyfin, Nextcloud<br />Paperless, Immich<br />Gitea, Grafana, Homepage<br />SQL Server, MongoDB]
                SQL[(PostgreSQL / SQL Server)]
                end
                subgraph "eva-02 (ThinkCentre)"
                DOCKER2[docker-vm<br />Portfólio · CRM HLG/PRD<br />API do RAG]
                end
                end

                INET <-->
                    ROTEADOR
                    ROTEADOR <-->
                        WIFI
                        ROTEADOR <-->
                            |WAN| OPN
                            OPN <-->
                                |LAN| SWITCH
                                SWITCH <--> NPM
                                NPM <--> DOCKER1
                                NPM <--> DOCKER2
                                DOCKER1 --> SQL
                                DOCKER2 -->|SQL| SQL
            </div>
            <div class="card mt-3">
                <div class="card-body">
                    <h5 class="card-title">Fluxo de Tráfego</h5>
                    <ul class="mb-0">
                        <li><strong>Serviços HTTP:</strong> Internet → Cloudflare → cloudflared → NPM → Serviço</li>
                        <li><strong>Cockpit/SSH:</strong> Internet → Cloudflare → cloudflared → Serviço (direto)</li>
                        <li><strong>RAG:</strong> agentes → API (eva-02) → PostgreSQL/pgvector (eva-01) via LAN</li>
                    </ul>
                </div>
            </div>
        </section>

        <section class="mb-5">
            <h2 class="h4 mb-3">Servidores</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="card h-100 border-primary">
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">eva-01 (Desktop)</h5>
                        </div>
                        <div class="card-body">
                            <p><strong>SO:</strong> Zorin OS + CasaOS</p>
                            <p><strong>Especificações:</strong></p>
                            <ul>
                                <li>CPU: Intel i7-3770 (8 núcleos)</li>
                                <li>RAM: 24GB</li>
                                <li>Armazenamento: 2.5 TB HDD</li>
                            </ul>
                            <p><strong>Serviços:</strong></p>
                            <ul>
                                <li>Jellyfin, Nextcloud, Paperless-NGX</li>
                                <li>Immich, Gitea, RomM</li>
                                <li>AdGuard Home, Homepage</li>
                                <li>SQL Server, MongoDB</li>
                                <li>Prometheus, Grafana, Uptime Kuma</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100 border-success">
                        <div class="card-header bg-success text-white">
                            <h5 class="card-title mb-0">eva-02 (ThinkCentre M93p)</h5>
                        </div>
                        <div class="card-body">
                            <p><strong>SO:</strong> Proxmox (hypervisor)</p>
                            <p><strong>Especificações:</strong></p>
                            <ul>
                                <li>CPU: Intel i3-4330t</li>
                                <li>RAM: 8GB</li>
                                <li>Armazenamento: 120GB SSD</li>
                            </ul>
                            <p><strong>VMs:</strong></p>
                            <ul>
                                <li><strong>OPNsense:</strong> 4 cores, 4GB RAM — firewall</li>
                                <li><strong>docker-vm:</strong> 2 cores, 2GB RAM — portfólio, CRM HLG/PRD, apps .NET e API do RAG</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="mb-5">
            <h2 class="h4 mb-3">Rede Híbrida</h2>
            <p>
                Toda a rede do homelab passa pelo OPNsense antes de chegar ao switch — isso garante
                isolamento real entre o lab e a rede da casa, além de controle centralizado de firewall,
                DNS e DHCP.
            </p>
            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">Rede da Casa</h5>
                            <ul class="mb-0">
                                <li>Estável e independente do lab</li>
                                <li>Isolada de qualquer falha nos servidores</li>
                                <li>Wi-Fi e dispositivos pessoais não interferem no ambiente</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">Rede do Homelab</h5>
                            <ul class="mb-0">
                                <li>Tudo passa pelo OPNsense (192.168.1.x)</li>
                                <li>Controle centralizado: firewall, DHCP, DNS</li>
                                <li>Ponto único para políticas de rede e monitoramento</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="mb-5">
            <h2 class="h4 mb-3">CI/CD Pipeline</h2>
            <div class="mermaid">
                graph LR
                A[Push<br />GitHub] --> B[GitHub Actions]
                B --> C[Instala<br />cloudflared]
                C --> D[Abre Túnel<br />SSH]
                D --> E[git pull]
                E --> F[docker compose<br />up -d]
            </div>
            <div class="card mt-3">
                <div class="card-body">
                    <p class="card-text">
                        O provedor usa CGNAT — sem IP fixo, sem possibilidade de abrir portas diretamente.
                        A solução foi usar Cloudflare Tunnel como canal de SSH: o GitHub Actions instala o
                        <code>cloudflared</code>, abre um túnel autenticado até o servidor e executa o deploy.
                        Resultado: pipeline completamente automatizado, zero portas expostas, zero dependência de IP fixo.
                        O mesmo fluxo faz o deploy do portfólio, do CRM HLG, do CRM PRD e da API do RAG.
                    </p>
                    <p class="card-text mb-0">
                        Com a migração para o <strong>Nginx Proxy Manager</strong>, o <code>cloudflared</code> agora
                        possui apenas 3 regras (Cockpit, SSH e um catch-all para o NPM) — qualquer novo serviço
                        é adicionado via interface web do NPM em ~2 minutos, sem editar YAML e sem reiniciar o túnel.
                    </p>
                </div>
            </div>
        </section>

        <section class="mb-5">
            <p class="section-kicker">Observabilidade</p>
            <h2 class="section-title">Nível 3: enxergar antes de quebrar</h2>
            <p class="prose-width">
                O roadmap tem cinco níveis. O terceiro foi o que mais mudou o jogo: antes eu descobria
                problema quando algo parava de responder; agora vejo a métrica antes de virar incidente.
            </p>
            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">Métricas</h5>
                            <ul class="mb-0">
                                <li><strong>Prometheus + Grafana</strong> com node_exporter nos hosts</li>
                                <li><strong>cAdvisor</strong> para métricas por container</li>
                                <li><strong>blackbox exporter</strong> para probes HTTP e ICMP</li>
                                <li>Dashboards de visão geral, por host e por container</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">Heartbeat e visão única</h5>
                            <ul class="mb-0">
                                <li><strong>Uptime Kuma</strong> para heartbeat e alertas de queda</li>
                                <li><strong>Homepage</strong> (gethomepage.dev) como single pane of glass</li>
                                <li>Próximo passo: <strong>Loki</strong> para logs centralizados</li>
                                <li>Depois: alertas mais elaborados no Telegram</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="mb-5">
            <p class="section-kicker">Aplicações</p>
            <h2 class="section-title">O que roda em produção</h2>
            <ul class="mb-0">
                <li><strong>Portfólio</strong> — este site, em container no eva-02</li>
                <li><strong>CRM HLG e CRM PRD</strong> — aplicação vendida para o cliente, com banco no eva-01</li>
                <li><strong>API do RAG</strong> — no eva-02, com PostgreSQL/pgvector no eva-01; os agentes acessam via MCP</li>
            </ul>
        </section>

        <section class="mb-5">
            <h2 class="h4 mb-3">Stack</h2>
            <div class="d-flex flex-wrap gap-2">
                <span class="badge bg-primary">Proxmox</span>
                <span class="badge bg-success">Docker</span>
                <span class="badge bg-info">OPNsense</span>
                <span class="badge bg-danger">Nginx Proxy Manager</span>
                <span class="badge bg-warning text-dark">Cloudflare Tunnels</span>
                <span class="badge bg-primary">GitHub Actions</span>
                <span class="badge bg-dark">Linux</span>
                <span class="badge bg-secondary">SQL Server / PostgreSQL</span>
                <span class="badge bg-warning text-dark">Prometheus / Grafana</span>
                <span class="badge bg-info">Uptime Kuma</span>
                <span class="badge bg-success">Homepage</span>
            </div>
        </section>

        <section class="mb-5">
            <h2 class="h4 mb-3">Planos Futuros</h2>
            <ul class="list-group">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Loki + logs centralizados
                    <span class="badge bg-warning text-dark">Prioridade 1</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Alertas automatizados no Telegram
                    <span class="badge bg-info">Prioridade 2</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Widgets de Portainer, Proxmox e OPNsense no Homepage
                    <span class="badge bg-secondary">Prioridade 3</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Backup automatizado do SQL Server com retenção
                    <span class="badge bg-primary">Prioridade 4</span>
                </li>
            </ul>
        </section>
    </div>
</div>
