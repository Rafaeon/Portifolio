@{
    ViewData["Title"] = "HomeLab";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
                <li class="breadcrumb-item active">HomeLab</li>
            </ol>
        </nav>

        <p class="section-kicker">Infra · produção real</p>
        <h1 class="display-6 fw-bold mb-3">HomeLab</h1>

        <section class="mb-5">
            <h2 class="h4 mb-3">Visão Geral</h2>
            <p>
                Infraestrutura doméstica com três servidores físicos em operação real — não um ambiente de testes,
                mas um lab que roda mais de 10 serviços self-hosted, hospeda aplicações .NET com pipeline CI/CD,
                tem rede segmentada com firewall dedicado e um servidor de IA local em modo backup.
            </p>
            <p>
                O objetivo é aprender fazendo: cada serviço, cada VM e cada decisão de rede resolve um problema real
                ou simula um cenário que existe em ambientes corporativos.
            </p>
            <div class="alert alert-info">
                <strong>Modelo Híbrido:</strong> A rede do homelab é separada da rede da casa.
                Se algo quebrar no laboratório, a internet da casa continua funcionando normalmente.
            </div>
        </section>

        <section class="mb-5">
            <h2 class="h4 mb-3">Arquitetura de Rede</h2>
            <div class="mermaid">
                graph TB
                subgraph "Internet"
                INET[Internet]
                end

                subgraph "Rede da Casa"
                ROTEADOR[Roteador do Provedor<br />Wi-Fi + NAT + DHCP]
                WIFI[Celular / Wi-Fi da Casa]
                end

                subgraph "Homelab"
                OPN[OPNsense VM<br />Firewall]
                SWITCH[Switch Homelab]
                NPM[Nginx Proxy<br />Manager]
                subgraph "eva-01 (Desktop)"
                DOCKER1[Docker Services<br />Jellyfin, Nextcloud<br />Paperless, Immich<br />Grafana, Uptime Kuma<br />Open WebUI]
                SQL[(SQL Server)]
                end
                subgraph "eva-02 (ThinkCentre)"
                DOCKER2[docker-vm<br />CRM HLG + PRD<br />Portfólio]
                end
                subgraph "eva-03 (Dell Inspiron)"
                OLLAMA[Ollama<br />IA Local]
                end
                end

                INET <-->
                    ROTEADOR
                    ROTEADOR <-->
                        WIFI
                        ROTEADOR <-->
                            |WAN| OPN
                            OPN <-->
                                |LAN| SWITCH
                                SWITCH <--> NPM
                                NPM <--> DOCKER1
                                NPM <--> DOCKER2
                                SWITCH <--> OLLAMA
                                DOCKER1 --> SQL
                                DOCKER2 -->|SQL| SQL
                                DOCKER1 -->|API| OLLAMA
            </div>
            <div class="card mt-3">
                <div class="card-body">
                    <h5 class="card-title">Fluxo de Tráfego</h5>
                    <ul class="mb-0">
                        <li><strong>Serviços HTTP:</strong> Internet → Cloudflare → cloudflared → NPM → Serviço</li>
                        <li><strong>Cockpit/SSH:</strong> Internet → Cloudflare → cloudflared → Serviço (direto)</li>
                        <li><strong>IA Local:</strong> Open WebUI (eva-01) → API Ollama (eva-03) via LAN</li>
                    </ul>
                </div>
            </div>
        </section>

        <section class="mb-5">
            <h2 class="h4 mb-3">Servidores</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card h-100 border-primary">
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">eva-01 (Desktop)</h5>
                        </div>
                        <div class="card-body">
                            <p><strong>SO:</strong> Zorin OS + CasaOS</p>
                            <p><strong>Especificações:</strong></p>
                            <ul>
                                <li>CPU: Intel i7-3770 (8 núcleos)</li>
                                <li>RAM: 24GB</li>
                                <li>Armazenamento: 2TB HDD</li>
                            </ul>
                            <p><strong>Serviços:</strong></p>
                            <ul>
                                <li>Jellyfin, Nextcloud, Paperless</li>
                                <li>Immich, Grafana, Uptime Kuma</li>
                                <li>AdGuard Home, Gitea</li>
                                <li>SQL Server</li>
                                <li>Open WebUI (porta 3014)</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-success">
                        <div class="card-header bg-success text-white">
                            <h5 class="card-title mb-0">eva-02 (ThinkCentre M93p)</h5>
                        </div>
                        <div class="card-body">
                            <p><strong>SO:</strong> Proxmox (hypervisor)</p>
                            <p><strong>Especificações:</strong></p>
                            <ul>
                                <li>CPU: Intel i3-4330t</li>
                                <li>RAM: 8GB</li>
                                <li>Armazenamento: 120GB SSD</li>
                            </ul>
                            <p><strong>VMs:</strong></p>
                            <ul>
                                <li><strong>OPNsense:</strong> 4 cores, 4GB RAM — firewall</li>
                                <li><strong>docker-vm:</strong> 2 cores, 2GB RAM — apps .NET</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-warning">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="card-title mb-0">eva-03 (Dell Inspiron 7472)</h5>
                        </div>
                        <div class="card-body">
                            <p><strong>SO:</strong> Ubuntu Server (bare metal)</p>
                            <p><strong>Especificações:</strong></p>
                            <ul>
                                <li>CPU: Intel i5-8250U</li>
                                <li>RAM: 8GB</li>
                                <li>GPU: GeForce MX150 (2GB)</li>
                            </ul>
                            <p><strong>Serviços:</strong></p>
                            <ul>
                                <li><strong>Ollama:</strong> API de inferência local (porta 11434) — modo backup</li>
                                <li>qwen2.5-coder:7b</li>
                                <li>deepseek-r1:8b (Q4_K_M)</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="mb-5">
            <h2 class="h4 mb-3">Rede Híbrida</h2>
            <p>
                Toda a rede do homelab passa pelo OPNsense antes de chegar ao switch — isso garante
                isolamento real entre o lab e a rede da casa, além de controle centralizado de firewall,
                DNS e DHCP.
            </p>
            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">Rede da Casa</h5>
                            <ul class="mb-0">
                                <li>Estável e independente do lab</li>
                                <li>Isolada de qualquer falha nos servidores</li>
                                <li>Wi-Fi e dispositivos pessoais não interferem no ambiente</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">Rede do Homelab</h5>
                            <ul class="mb-0">
                                <li>Tudo passa pelo OPNsense (192.168.1.x)</li>
                                <li>Controle centralizado: firewall, DHCP, DNS</li>
                                <li>Ponto único para políticas de rede e monitoramento</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="mb-5">
            <h2 class="h4 mb-3">CI/CD Pipeline</h2>
            <div class="mermaid">
                graph LR
                A[Push<br />GitHub] --> B[GitHub Actions]
                B --> C[Instala<br />cloudflared]
                C --> D[Abre Túnel<br />SSH]
                D --> E[git pull]
                E --> F[docker compose<br />up -d]
            </div>
            <div class="card mt-3">
                <div class="card-body">
                    <p class="card-text">
                        O provedor usa CGNAT — sem IP fixo, sem possibilidade de abrir portas diretamente.
                        A solução foi usar Cloudflare Tunnel como canal de SSH: o GitHub Actions instala o
                        <code>cloudflared</code>, abre um túnel autenticado até o servidor e executa o deploy.
                        Resultado: pipeline completamente automatizado, zero portas expostas, zero dependência de IP fixo.
                    </p>
                    <p class="card-text mb-0">
                        Com a migração para o <strong>Nginx Proxy Manager</strong>, o <code>cloudflared</code> agora
                        possui apenas 3 regras (Cockpit, SSH e um catch-all para o NPM) — qualquer novo serviço
                        é adicionado via interface web do NPM em ~2 minutos, sem editar YAML e sem reiniciar o túnel.
                    </p>
                </div>
            </div>
        </section>

        <section class="mb-5">
            <p class="section-kicker">Homelab</p>
            <h2 class="section-title">IA Local — Ollama (backup)</h2>
            <p class="prose-width">
                O eva-03 mantém Ollama + Open WebUI prontos na LAN como <strong>backup local</strong> de inferência.
                O uso diário de IA no fluxo de dev acontece em ferramentas de orquestração de agentes
                (MiMoCode e chats free via MCP) — o lab local é reserva quando a nuvem/conta externa não resolve.
            </p>
            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">Arquitetura</h5>
                            <ul class="mb-0">
                                <li><strong>eva-03:</strong> Ollama rodando via systemd nativo</li>
                                <li><strong>eva-01:</strong> Open WebUI como interface</li>
                                <li><strong>Comunicação:</strong> API REST via LAN</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">Modelos</h5>
                            <ul class="mb-0">
                                <li><strong>qwen2.5-coder:7b</strong> — código e programação</li>
                                <li><strong>deepseek-r1:8b</strong> — raciocínio (Q4_K_M)</li>
                                <li><em>Pendente:</em> qwen2.5, nomic-embed-text</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="mb-5">
            <h2 class="h4 mb-3">Stack</h2>
            <div class="d-flex flex-wrap gap-2">
                <span class="badge bg-primary">Proxmox</span>
                <span class="badge bg-success">Docker</span>
                <span class="badge bg-info">OPNsense</span>
                <span class="badge bg-danger">Nginx Proxy Manager</span>
                <span class="badge bg-warning text-dark">Cloudflare Tunnels</span>
                <span class="badge bg-primary">GitHub Actions</span>
                <span class="badge bg-dark">Linux</span>
                <span class="badge bg-secondary">SQL Server</span>
                <span class="badge-stack"><i class="devicon-ollama-plain" aria-hidden="true"></i> Ollama (backup)</span>
                <span class="badge bg-success">Open WebUI</span>
            </div>
        </section>

        <section class="mb-5">
            <h2 class="h4 mb-3">Planos Futuros</h2>
            <ul class="list-group">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Backup automatizado do SQL Server — hoje o banco não tem rotina de backup, o que é o maior risco real do ambiente
                    <span class="badge bg-warning text-dark">Prioridade 1</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Tailscale como fallback de acesso — redundância para quando o Cloudflare Tunnel não estiver disponível
                    <span class="badge bg-info">Prioridade 2</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Snapshots automáticos no Proxmox — ponto de restauração rápido para as VMs em caso de falha
                    <span class="badge bg-secondary">Prioridade 3</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Expandir modelos Ollama — testar qwen2.5 e nomic-embed-text para embeddings
                    <span class="badge bg-primary">Prioridade 4</span>
                </li>
            </ul>
        </section>
    </div>
</div>
