@{
    ViewData["Title"] = "Contatos";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
                <li class="breadcrumb-item active">Contatos</li>
            </ol>
        </nav>

        <p class="section-kicker">Contato</p>
        <h1 class="display-6 fw-bold mb-2">Vamos conversar</h1>
        <p class="text-muted mb-4 prose-width">
            Para oportunidades, projetos ou uma segunda opinião técnica — o canal mais rápido é o e-mail.
        </p>

        <div class="row g-4">
            <div class="col-12">
                <div class="card contact-primary">
                    <div class="card-body text-center py-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="contact-icon" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"/>
                        </svg>
                        <h5 class="card-title mb-1">E-mail</h5>
                        <p class="card-text mb-3">
                            <a href="mailto:rafeltorress1@gmail.com" class="text-decoration-none" id="email-link">
                                rafeltorress1@gmail.com
                            </a>
                        </p>
                        <div class="d-flex flex-wrap gap-2 justify-content-center">
                            <a href="mailto:rafeltorress1@gmail.com" class="btn btn-primary">Enviar e-mail</a>
                            <button type="button" class="btn btn-outline-secondary" id="copy-email" data-email="rafeltorress1@gmail.com">
                                Copiar endereço
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 reveal">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <i class="devicon-linkedin-plain colored" style="font-size:2.5rem" aria-hidden="true"></i>
                        </div>
                        <h5 class="card-title">LinkedIn</h5>
                        <p class="card-text">
                            <a href="https://linkedin.com/in/rafael-torres-799523231" target="_blank" rel="noopener" class="text-decoration-none">
                                Rafael Torres
                            </a>
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 reveal">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <i class="devicon-github-original" style="font-size:2.5rem;color:var(--text)" aria-hidden="true"></i>
                        </div>
                        <h5 class="card-title">GitHub</h5>
                        <p class="card-text">
                            <a href="https://github.com/Rafaeon" target="_blank" rel="noopener" class="text-decoration-none">
                                Rafaeon
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const btn = document.getElementById('copy-email');
            if (!btn) return;
            btn.addEventListener('click', async () => {
                const email = btn.getAttribute('data-email') || '';
                try {
                    await navigator.clipboard.writeText(email);
                    const original = btn.textContent;
                    btn.textContent = 'Copiado!';
                    setTimeout(() => { btn.textContent = original; }, 1600);
                } catch {
                    window.location.href = 'mailto:' + email;
                }
            });
        })();
    </script>
}
