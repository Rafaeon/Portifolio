@model Portifolio.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="row">
    <div class="col-md-6 col-lg-5 mx-auto">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
                <li class="breadcrumb-item active">Login</li>
            </ol>
        </nav>

        <p class="section-kicker">Acesso restrito</p>
        <h1 class="display-6 fw-bold mb-2">Entrar</h1>
        <p class="text-muted mb-4 prose-width">
            Área do administrador da newsletter.
        </p>

        <div class="card">
            <div class="card-body p-4">
                <form asp-controller="Account" asp-action="Login" method="post" autocomplete="off">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    @if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}

                    <div class="mb-3">
                        <label asp-for="Usuario" class="form-label">Usuário</label>
                        <input asp-for="Usuario" class="form-control" autofocus />
                        <span asp-validation-for="Usuario" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Senha" class="form-label">Senha</label>
                        <input asp-for="Senha" class="form-control" />
                        <span asp-validation-for="Senha" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Entrar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
