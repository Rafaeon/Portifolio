@model Portifolio.Models.AlterarCredenciaisInput
@{
    ViewData["Title"] = "Alterar credenciais";
}

<div class="row">
    <div class="col-lg-7 mx-auto">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Admin</a></li>
                <li class="breadcrumb-item active">Credenciais</li>
            </ol>
        </nav>

        <p class="section-kicker">Segurança</p>
        <h1 class="display-6 fw-bold mb-2">Alterar login e senha</h1>
        <p class="text-muted mb-4">
            Depois de alterar, use o novo usuário e a nova senha no próximo login.
        </p>

        <div class="card">
            <div class="card-body p-4">
                <form asp-controller="Account" asp-action="AlterarCredenciais" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="SenhaAtual" class="form-label">Senha atual</label>
                        <input asp-for="SenhaAtual" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="SenhaAtual" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NovoUsuario" class="form-label">Novo usuário</label>
                        <input asp-for="NovoUsuario" class="form-control" autocomplete="username" />
                        <span asp-validation-for="NovoUsuario" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NovaSenha" class="form-label">Nova senha</label>
                        <input asp-for="NovaSenha" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NovaSenha" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmarSenha" class="form-label">Confirmar nova senha</label>
                        <input asp-for="ConfirmarSenha" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmarSenha" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Salvar</button>
                        <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Index">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
